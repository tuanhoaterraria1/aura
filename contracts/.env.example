# Copy to .env and fill in. Everything here is PUBLIC launch input: no private keys, no API keys.
# Never invent metadata: use the project's real name, logo, website and X profile.

PROGRAMMABLE_LAUNCH_WALLET=0xYourLaunchWallet
PROGRAMMABLE_PUBLIC_ORIGIN=https://github.com/your-org/cortex-hook
PROGRAMMABLE_SOURCE_REVISION=exact40characterlowercasecommitofthepushedsource00
# node -e "console.log('0x'+require('crypto').randomBytes(32).toString('hex'))"
PROGRAMMABLE_LAUNCH_NONCE=0x...

PROGRAMMABLE_TOKEN_NAME=
PROGRAMMABLE_TOKEN_SYMBOL=
PROGRAMMABLE_PROJECT_DESCRIPTION=
PROGRAMMABLE_PROJECT_IMAGE_SOURCE_PATH=assets/logo.png
PROGRAMMABLE_PROJECT_IMAGE_URI=https://your-site.example/logo.png
PROGRAMMABLE_WEBSITE_URL=https://your-site.example/
PROGRAMMABLE_X_URL=https://x.com/your_handle
# PROGRAMMABLE_TELEGRAM_URL=
# PROGRAMMABLE_DISCORD_URL=
# PROGRAMMABLE_GITHUB_URL=
# PROGRAMMABLE_DOCS_URL=

# Separate hot wallet the AI agent signs with (never the launch wallet). 0x000...000 = no agent.
CORTEX_AGENT_ADDRESS=0xYourAgentHotWallet
# Opening price: whole tokens per 1 ETH. 300000000 with a 1B supply = ~3.33 ETH fully diluted.
CORTEX_START_TOKENS_PER_ETH=300000000
# Optional initial buy by the launch wallet (wei) and its slippage floor (token base units).
CORTEX_INITIAL_BUY_WEI=0
CORTEX_MIN_INITIAL_BUY_TOKENS=0
# PROGRAMMABLE_TOKEN_SUPPLY=1000000000000000000000000000
# PROGRAMMABLE_PERMIT_DEADLINE_SECONDS=3540   (max; run pack right after build)

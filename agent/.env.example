# Claude API key (or run `ant auth login` and leave this unset)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Ethereum Mainnet RPC
RPC_URL=https://eth-mainnet.example/your-key
# CortexHook address from the finalized Programmable launch
HOOK_ADDRESS=0x...

# Hot wallet set as hook.agent at launch. Keep only gas money on it.
# Leave empty to run read-only.
AGENT_PRIVATE_KEY=
# Transactions are sent only when this is exactly "false"
DRY_RUN=true

INTERVAL_MINUTES=20
SHORT_WINDOW_BLOCKS=300
LONG_WINDOW_BLOCKS=1800
BUYBACK_SLIPPAGE_BPS=300
MIN_DISTRIBUTE_WEI=10000000000000000

# Where agent/reasoning/<hash>.json is publicly served, e.g. https://your-site.example/reasoning
REASONING_BASE_URL=
